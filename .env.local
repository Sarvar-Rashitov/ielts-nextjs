# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# 1. Go to https://app.supabase.com/project/YOUR_PROJECT/settings/api
# 2. Copy "Project URL" and "anon public" key

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# GOOGLE OAUTH CONFIGURATION (via Supabase)
# ============================================================================
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable "Google+ API"
# 4. Go to Credentials → Create Credentials → OAuth 2.0 Client ID
# 5. Application Type: Web application
# 6. Authorized redirect URIs:
#    - https://YOUR_PROJECT_ID.supabase.co/auth/v1/callback
#    - http://localhost:3000/auth/callback (for local testing)
# 7. Copy Client ID and Client Secret
# 8. Go to Supabase Dashboard → Authentication → Providers → Google
# 9. Enable Google provider and paste Client ID and Client Secret
# 10. Save changes
#
# Note: Google OAuth is configured in Supabase, not in .env
# The code already uses supabase.auth.signInWithOAuth({ provider: "google" })

# ============================================================================
# CLICK.UZ PAYMENT INTEGRATION
# ============================================================================
# 1. Register at https://click.uz/
# 2. Create a merchant account
# 3. Get credentials from Click.uz dashboard

CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# ============================================================================
# DEEPSEEK AI (for Writing Evaluation)
# ============================================================================
# 1. Register at https://platform.deepseek.com/
# 2. Go to API Keys section
# 3. Create new API key

DEEPSEEK_API_KEY=

# ============================================================================
# SITE CONFIGURATION
# ============================================================================
# For local development: http://localhost:3000
# For production: https://yourdomain.com

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Support contact
NEXT_PUBLIC_SUPPORT_EMAIL=support@ieltscdi.com
